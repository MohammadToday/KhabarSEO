#!/usr/bin/env bash
# Builds dist/khabar-seo-repo-<version>.zip: the whole repository with every dotfile,
# zip root = repository root (no wrapping folder). Excludes dist/, vendor/, node_modules/, tools/ and zips.
# Usage: bin/build-repo-zip
set -euo pipefail
cd "$(dirname "$0")/.."
VERSION=$(sed -n 's/^ \* Version:[[:space:]]*//p' khabar-seo.php | head -1 | tr -d '\r')
[ -n "$VERSION" ] || { echo "Cannot read version" >&2; exit 1; }
mkdir -p dist
OUT="dist/khabar-seo-repo-${VERSION}.zip"
rm -f "$OUT"
find . -type f \
	-not -path './.git/*' -not -path './dist/*' -not -path './vendor/*' \
	-not -path './node_modules/*' -not -path './tools/*' -not -name '*.zip' -not -name '.DS_Store' \
	| sed 's#^\./##' | LC_ALL=C sort | zip -q -X "$OUT" -@
echo "Built $OUT"
