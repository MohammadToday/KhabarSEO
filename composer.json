{
	"name": "mohammadtoday/khabar-seo",
	"description": "Lightweight, configurable SEO for news websites, built Persian-first for RTL publishers and usable in any language.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/MohammadToday/KhabarSEO",
	"authors": [
		{
			"name": "Mohammad Ahmadi Akbari",
			"homepage": "https://github.com/MohammadToday"
		}
	],
	"support": {
		"issues": "https://github.com/MohammadToday/KhabarSEO/issues",
		"source": "https://github.com/MohammadToday/KhabarSEO"
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-coding-standards/wpcs": "^3.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "find . -name '*.php' -not -path './vendor/*' -not -path './tools/*' -print0 | xargs -0 -n1 php -l > /dev/null",
		"smoke": "php tests/smoke.php",
		"phpcs": "phpcs",
		"compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.1-8.5 --extensions=php --ignore=tests,vendor,tools src data assets khabar-seo.php uninstall.php",
		"generality": "bash bin/check-generality",
		"pot": "php bin/make-pot.php",
		"po": "php bin/merge-po.php",
		"mo": "php bin/build-mo.php",
		"build": "bin/build-zip",
		"build-repo": "bin/build-repo-zip"
	}
}
